{
  "_note": "Dispatcher regression corpus (design C.5). `world` is the context every case is judged against; `model_output` is the structured output the model is expected to produce for `message`, and `expect` is what relay must then do with it. The unit test replays `model_output` through the real Dispatcher + TaskService, so it guards the pipeline and the guardrails. No live accuracy runner reads this file yet: `model_output` is recorded so one can diff a real model against it later.",
  "world": {
    "max_split": 4,
    "projects": [
      { "id": "p-alpha", "name": "alpha-app", "path": "/tmp/alpha-app" },
      { "id": "p-freee", "name": "beta-service", "path": "/tmp/beta-service" },
      { "id": "p-gamma-tool", "name": "gamma-tool", "path": "/tmp/gamma-tool" }
    ],
    "tasks": [
      { "display_id": "T-01", "project": "alpha-app", "title": "navigation icon update", "status": "running" }
    ]
  },
  "cases": [
    {
      "name": "single/new_task — one project, one piece of work",
      "kind": "single",
      "message": "alpha-app 화면에 대비 모드 추가해줘",
      "model_output": { "action": "new_task", "project": "alpha-app", "title": "대비 모드", "size": "normal", "prompt": "alpha-app 화면에 대비 모드 추가해줘", "confidence": "high" },
      "expect": { "dispatch_state": "dispatched", "action": "new_task", "created": ["T-02"], "routed": [], "badge": "dispatcher · new_task · normal · alpha-app" }
    },
    {
      "name": "single/route_to_task — a follow-up to a running task",
      "kind": "single",
      "message": "그 아이콘 크기도 32px 로 맞춰줘",
      "model_output": { "action": "route_to_task", "task_id": "T-01", "prompt": "아이콘 크기도 32px 로 맞춰줘", "confidence": "high" },
      "expect": { "dispatch_state": "dispatched", "action": "route_to_task", "created": [], "routed": ["T-01"], "badge": "dispatcher · route_to_task · T-01" }
    },
    {
      "name": "single/answer_directly — a question that needs no work",
      "kind": "single",
      "message": "worktree 는 태스크마다 하나씩 생기는 거 맞지?",
      "model_output": { "action": "answer_directly", "answer": "네, 태스크마다 별도 워크트리가 생깁니다.", "confidence": "high" },
      "expect": { "dispatch_state": "dispatched", "action": "answer_directly", "created": [], "routed": [], "badge": "dispatcher · answer_directly" }
    },
    {
      "name": "single/close_task — the user asks to finish one",
      "kind": "single",
      "message": "T-01 이제 닫아도 돼",
      "model_output": { "action": "close_task", "task_id": "T-01", "confidence": "high" },
      "expect": { "dispatch_state": "dispatched", "action": "close_task", "created": [], "routed": [], "badge": "dispatcher · close_task · T-01" }
    },
    {
      "name": "single/low confidence — ambiguous target",
      "kind": "single",
      "message": "그거 좀 고쳐줘",
      "model_output": { "action": "route_to_task", "task_id": "T-01", "prompt": "그거 좀 고쳐줘", "confidence": "low" },
      "expect": { "dispatch_state": "needs_confirm", "created": [], "routed": [] }
    },
    {
      "name": "split/mixed projects — a worktree cannot span repositories",
      "kind": "split",
      "message": "alpha-app 쪽은 상태 배너를 붙이고, beta-service 는 예제 API를 채워줘",
      "model_output": {
        "action": "split",
        "confidence": "high",
        "items": [
          { "action": "new_task", "project": "alpha-app", "title": "재접속 배너", "size": "small", "prompt": "재접속 배너 붙여줘" },
          { "action": "new_task", "project": "beta-service", "title": "예제 API", "size": "normal", "prompt": "예제 API 마저 채워줘" }
        ]
      },
      "expect": { "dispatch_state": "dispatched", "action": "split", "created": ["T-02", "T-03"], "routed": [], "badge": "dispatcher · split · 2 · T-02 T-03" }
    },
    {
      "name": "split/related work in one project stays one task",
      "kind": "split",
      "message": "alpha-app 입력을 여러 줄로 바꾸고, 임시값 복원과 버튼 정렬도 고쳐줘",
      "model_output": { "action": "new_task", "project": "alpha-app", "title": "입력 개선", "size": "normal", "prompt": "입력을 여러 줄로 바꾸고, 임시값 복원과 버튼 정렬까지 고쳐줘", "confidence": "high" },
      "expect": { "dispatch_state": "dispatched", "action": "new_task", "created": ["T-02"], "routed": [], "badge": "dispatcher · new_task · normal · alpha-app" }
    },
    {
      "name": "split/over the cap — five pieces against max_split 4",
      "kind": "split",
      "message": "alpha-app, beta-service, gamma-tool의 예제 문서도 갱신해줘",
      "model_output": {
        "action": "split",
        "confidence": "high",
        "items": [
          { "action": "new_task", "project": "alpha-app", "title": "정리", "size": "normal", "prompt": "alpha-app을 손봐줘" },
          { "action": "new_task", "project": "beta-service", "title": "정리", "size": "normal", "prompt": "beta-service를 손봐줘" },
          { "action": "new_task", "project": "gamma-tool", "title": "정리", "size": "normal", "prompt": "gamma-tool을 손봐줘" },
          { "action": "new_task", "project": "alpha-app", "title": "예제 문서", "size": "small", "prompt": "예제 문서 갱신해줘" },
          { "action": "new_task", "project": "alpha-app", "title": "README", "size": "small", "prompt": "README 갱신해줘" }
        ]
      },
      "expect": { "dispatch_state": "needs_confirm", "created": [], "routed": [] }
    },
    {
      "name": "split/one ambiguous piece fails the whole split",
      "kind": "split",
      "message": "gamma-tool 변환기를 고치고, 이전 작업도 마저 해줘",
      "model_output": {
        "action": "split",
        "confidence": "high",
        "items": [
          { "action": "new_task", "project": "gamma-tool", "title": "변환기", "size": "normal", "prompt": "변환기 고쳐줘", "confidence": "high" },
          { "action": "route_to_task", "task_id": "T-01", "prompt": "이전 작업도 마저 해줘", "confidence": "low" }
        ]
      },
      "expect": { "dispatch_state": "needs_confirm", "created": [], "routed": [] }
    },
    {
      "name": "split/follow-up plus new work in another project",
      "kind": "split",
      "message": "아이콘은 32px 로 맞추고, gamma-tool 변환기도 새로 시작해줘",
      "model_output": {
        "action": "split",
        "confidence": "high",
        "items": [
          { "action": "route_to_task", "task_id": "T-01", "prompt": "아이콘 크기를 32px 로 맞춰줘" },
          { "action": "new_task", "project": "gamma-tool", "title": "변환기", "size": "normal", "prompt": "변환기 새로 시작해줘" }
        ]
      },
      "expect": { "dispatch_state": "dispatched", "action": "split", "created": ["T-02"], "routed": ["T-01"], "badge": "dispatcher · split · 2 · T-01 T-02" }
    }
  ]
}
